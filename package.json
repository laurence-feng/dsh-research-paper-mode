{
  "name": "dsh-research-paper-mode",
  "version": "1.1.0",
  "description": "Research-paper writing mode for DeepSeek Harness: an agent preset with multi-engine literature search (DeepSeek / Kimi), paper polishing, style checks, citation formatting and bundled nature-* writing skills.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": [
    "index.js",
    "lib/**",
    "tools/**",
    "locale/**",
    "skills/**",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "mode",
    "research",
    "academic-writing",
    "paper",
    "literature-search",
    "citation",
    "bibtex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurence-feng/dsh-research-paper-mode.git"
  },
  "bugs": {
    "url": "https://github.com/laurence-feng/dsh-research-paper-mode/issues"
  },
  "homepage": "https://github.com/laurence-feng/dsh-research-paper-mode#readme"
}
